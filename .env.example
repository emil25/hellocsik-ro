# Optional: external PostgreSQL. Otherwise pnpm dev uses .local/pgdata.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hellocsik
# pnpm dev creates a random admin password in the git-ignored .env.local file.
# ADMIN_PASSWORD=
# Production must provide PostgreSQL, persistent image storage and a password.
# HOST=0.0.0.0
# PORT=8080

# Optional: richer Facebook previews and automatic event discovery from public sources.
# Create the key at https://www.firecrawl.dev/ and keep it only in .env.local.
# FIRECRAWL_API_KEY=fc-your-key
# Optional comma-separated name|URL sources. Defaults to szereda.ro and ProKult.
# FIRECRAWL_EVENT_SOURCES=szereda.ro|https://szereda.ro/esemenyek,ProKult|https://prokult.ro/szakszervezetek-muvelodesi-haza-csikszereda
